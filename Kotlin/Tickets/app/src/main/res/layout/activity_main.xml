<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Botón superior con margen lateral y superior -->
    <Button
        android:id="@+id/btnEscanear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:text="📷 Escanear Ticket (OCR)"
        android:textSize="16sp" />

    <!-- Visor de texto con el mismo margen lateral -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:background="#F5F5F5"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvResultadoOcr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Pulsa el botón superior para escanear un ticket y ver el texto reconstruido..."
            android:textColor="#212121"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </ScrollView>

    <!-- Botón inferior con margen lateral e inferior -->
    <Button
        android:id="@+id/btnCopiarTexto"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:text="📋 Copiar texto al portapapeles"
        android:textColor="#3B0B8E"
        app:strokeColor="#3B0B8E"
        app:strokeWidth="2dp" />
</LinearLayout>